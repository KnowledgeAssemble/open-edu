{
  "name": "@open-edu/dev-server",
  "version": "0.1.1",
  "private": true,
  "description": "OpenEdu Course Creator Studio (local hybrid authoring + preview)",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:browser": "vite build --mode browser",
    "preview:browser": "vite preview --mode browser",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@knowledgeassemble/engine-skills": "^0.1.2",
    "@open-edu/accessibility": "workspace:*",
    "@open-edu/companion": "workspace:*",
    "@open-edu/core": "workspace:*",
    "@open-edu/course-compiler": "workspace:^",
    "@open-edu/design-system": "workspace:*",
    "@open-edu/domain-guidance": "workspace:*",
    "@open-edu/i18n": "workspace:*",
    "@open-edu/llm-config": "workspace:^",
    "@open-edu/logger": "workspace:*",
    "@open-edu/oep-distribution": "workspace:^",
    "@open-edu/packs": "workspace:*",
    "@open-edu/rewards": "workspace:*",
    "@open-edu/runtime": "workspace:*",
    "@open-edu/schemas": "workspace:*",
    "@open-edu/storage": "workspace:*",
    "@open-edu/telemetry": "workspace:*",
    "@open-edu/widget-sdk": "workspace:*",
    "@open-edu/widgets": "workspace:*",
    "@open-edu/workflow": "workspace:*",
    "@vitejs/plugin-react": "^4.2.0",
    "ai": "^7.0.0",
    "ajv": "^8.0.0",
    "axe-core": "^4.7.0",
    "lucide-react": "^0.400.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.0",
    "sonner": "^1.7.0",
    "vite": "^5.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.5.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4"
  },
  "type": "module"
}
