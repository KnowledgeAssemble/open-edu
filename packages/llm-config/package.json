{
  "name": "@open-edu/llm-config",
  "version": "0.1.0",
  "private": true,
  "description": "LLM provider abstraction and configuration for Open-Edu",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
