{
  "name": "@open-edu/interactive-runtime",
  "version": "0.1.1",
  "private": true,
  "description": "OpenEdu host bridge and React mounts for the interactive engine (OpenEdu Interactivity)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
