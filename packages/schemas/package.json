{
  "name": "@open-edu/schemas",
  "version": "0.2.0",
  "description": "Zod schemas and TypeScript type generation for Open-Edu",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./learning-intents": {
      "types": "./dist/learning-intents.d.ts",
      "import": "./dist/learning-intents.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./intent-tags": {
      "types": "./dist/intent-tags.d.ts",
      "import": "./dist/intent-tags.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.22.0"
  },
  "type": "module"
}
