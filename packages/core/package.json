{
  "name": "@open-edu/core",
  "version": "0.1.1",
  "private": true,
  "description": "Package loader and validation for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./widget-catalog-data": {
      "types": "./dist/widget-catalog-data.d.ts",
      "import": "./dist/widget-catalog-data.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/widget-catalog-data.json dist/ && node scripts/generate-catalog-data-module.mjs",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/logger": "workspace:*",
    "@open-edu/schemas": "workspace:*",
    "topojson-client": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/topojson-client": "^3.1.5"
  },
  "type": "module"
}
