{
  "name": "@open-edu/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "XState workflow engine for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
