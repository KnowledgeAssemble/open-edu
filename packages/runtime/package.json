{
  "name": "@open-edu/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "React runtime renderer for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "require": "./dist/embed.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@dotlottie/react-player": "^1.6.19",
    "@open-edu/accessibility": "workspace:*",
    "@open-edu/core": "workspace:*",
    "@open-edu/design-system": "workspace:*",
    "@open-edu/i18n": "workspace:*",
    "@open-edu/rewards": "workspace:^",
    "@open-edu/schemas": "workspace:*",
    "@open-edu/widget-sdk": "workspace:*",
    "@open-edu/widgets": "workspace:*",
    "@open-edu/workflow": "workspace:*",
    "lucide-react": "^0.460.0",
    "rehype-react": "^8.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "rxjs": "^7.8.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/unist": "^3.0.0",
    "axe-core": "^4.12.1",
    "hast-util-to-jsx-runtime": "^2.0.0",
    "tailwindcss": "^3.4.0"
  },
  "type": "module"
}
