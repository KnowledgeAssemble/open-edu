{
  "name": "@open-edu/domain-guidance",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical domain guidance for OpenEdu course authoring (profiles, quality rubric, artifact contract views)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    },
    "./data/profiles": "./src/data/profiles.json",
    "./data/quality-rubric": "./src/data/quality-rubric.json",
    "./data/artifact-contract": "./src/data/artifact-contract.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-data.mjs",
    "generate": "tsc && node scripts/copy-data.mjs && node dist/generate.js",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@knowledgeassemble/engine-skills": "^0.1.2",
    "@open-edu/course-compiler": "workspace:^",
    "@open-edu/schemas": "workspace:^",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
