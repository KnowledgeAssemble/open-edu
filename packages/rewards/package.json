{
  "name": "@open-edu/rewards",
  "version": "0.1.0",
  "private": true,
  "description": "Reward broker for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "import": "./dist/broker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/schemas": "workspace:*",
    "@open-edu/telemetry": "workspace:*",
    "rxjs": "^7.8.0"
  }
}
