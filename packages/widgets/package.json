{
  "name": "@open-edu/widgets",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Widget SDK and built-in widgets for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./install": {
      "types": "./dist/install/index.d.ts",
      "import": "./dist/install/index.js"
    },
    "./catalog": {
      "types": "./dist/resolver/catalog.d.ts",
      "import": "./dist/resolver/catalog.js"
    },
    "./guide": {
      "types": "./dist/guide-markdown.d.ts",
      "import": "./dist/guide-markdown.js"
    },
    "./intents": {
      "types": "./dist/metadata/learning-intents.d.ts",
      "import": "./dist/metadata/learning-intents.js"
    },
    "./search": {
      "types": "./dist/search-filter.d.ts",
      "import": "./dist/search-filter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "generate:widget-docs": "tsx scripts/generate-widget-docs.ts",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@open-edu/design-system": "workspace:*",
    "@open-edu/i18n": "workspace:*",
    "@open-edu/schemas": "workspace:^",
    "@open-edu/widget-sdk": "workspace:*",
    "ajv": "^8.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "axe-core": "^4.12.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^3.4.19"
  }
}
