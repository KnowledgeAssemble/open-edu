{
  "name": "@open-edu/i18n",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./locale": {
      "types": "./src/locale.ts",
      "import": "./src/locale.ts"
    },
    "./locales/*": "./locales/*"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.2.0",
    "jsdom": "^24.0.0",
    "zod": "^3.22.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
