{
  "name": "@open-edu/telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "RxJS telemetry engine for Open-Edu",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./summary": {
      "types": "./dist/summary.d.ts",
      "import": "./dist/summary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/schemas": "workspace:*",
    "rxjs": "^7.8.0",
    "zod": "^3.0.0"
  },
  "type": "module"
}
