{
  "name": "open-edu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-Edu Framework: An open runtime for educational experiences",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint && node scripts/lint-no-inline-styles.mjs && node scripts/lint-no-hardcoded-strings.mjs --strict && node scripts/lint-no-raw-text-scales.mjs --strict && node scripts/check-tailwind-css.mjs",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:inline-styles": "node scripts/lint-no-inline-styles.mjs",
    "lint:hardcoded-strings": "node scripts/lint-no-hardcoded-strings.mjs",
    "lint:raw-text-scales": "node scripts/lint-no-raw-text-scales.mjs",
    "lint:tailwind-staleness": "node scripts/check-tailwind-css.mjs",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "check:freshness": "pnpm --filter @open-edu/domain-guidance generate && pnpm exec prettier --write packages/domain-guidance/src/data/engine-skills.json skills/openedu-course-authoring/references/engine-skills.md > /dev/null && git diff --exit-code -- packages/domain-guidance/src/data/engine-skills.json skills/openedu-course-authoring/references/engine-skills.md",
    "test:coverage": "vitest run --coverage",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm --filter @open-edu/schemas --filter @open-edu/logger --filter @open-edu/oep-distribution --filter @open-edu/registry --filter @open-edu/pwa-core --filter @open-edu/storage build && changeset publish",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "storybook": "pnpm --filter @open-edu/design-system storybook",
    "build-storybook": "pnpm --filter @open-edu/design-system build-storybook",
    "i18n:extract": "pnpm --filter @open-edu/cli build && node packages/cli/dist/cli.js i18n extract packages/runtime/src packages/i18n/locales/en",
    "i18n:validate": "pnpm --filter @open-edu/cli build && node packages/cli/dist/cli.js i18n validate packages/i18n/locales",
    "i18n:missing": "pnpm --filter @open-edu/cli build && node packages/cli/dist/cli.js i18n missing packages/i18n/locales hi"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@knowledgeassemble/engine-skills": "^0.1.2",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.17.0",
    "husky": "^9.1.0",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "stylelint": "^16.8.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-tailwindcss": "^0.0.7",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "lint-staged": {
    "packages/runtime/src/**/*.{ts,tsx}": [
      "pnpm --dir packages/runtime exec eslint --fix",
      "prettier --write"
    ],
    "packages/design-system/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
